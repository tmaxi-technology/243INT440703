<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Bài tập 2 - Nhập thông tin sinh viên</title>
  <style>
    table, th, td {
      border: 1px solid black;
      border-collapse: collapse;
      padding: 5px;
    }
    input, select {
      margin-bottom: 8px;
    }
  </style>
</head>
<body>
  <h2>Bài tập 2</h2>

  <form id="studentForm">
    <label>MSSV: </label><input type="text" id="mssv" required><br>
    <label>Họ tên: </label><input type="text" id="hoten" required><br>
    <label>Email: </label><input type="email" id="email" required><br>

    <label>Giới tính: </label>
    <input type="radio" name="gender" value="Nam" checked> Nam
    <input type="radio" name="gender" value="Nữ"> Nữ<br>

    <label>Nơi sinh: </label>
    <select id="noisinh">
      <option value="TP.HCM">TP.HCM</option>
      <option value="Hà Nội">Hà Nội</option>
      <option value="Cần Thơ">Cần Thơ</option>
      <option value="Đà Nẵng">Đà Nẵng</option>
    </select><br>

    <button type="button" onclick="themSinhVien()">Thêm sinh viên</button>
  </form>

  <h3>Danh sách sinh viên</h3>
  <table id="dsSinhVien">
    <thead>
      <tr>
        <th>MSSV</th>
        <th>Họ tên</th>
        <th>Email</th>
        <th>Giới tính</th>
        <th>Nơi sinh</th>
      </tr>
    </thead>
    <tbody>
      <!-- Dữ liệu thêm ở đây -->
    </tbody>
  </table>

  <script>
    function themSinhVien() {
      // Lấy dữ liệu từ form
      const mssv = document.getElementById("mssv").value;
      const hoten = document.getElementById("hoten").value;
      const email = document.getElementById("email").value;
      const noisinh = document.getElementById("noisinh").value;
      const gender = document.querySelector('input[name="gender"]:checked').value;

      // Tạo dòng mới
      const table = document.getElementById("dsSinhVien").getElementsByTagName('tbody')[0];
      const newRow = table.insertRow();

      const cell1 = newRow.insertCell(0);
      const cell2 = newRow.insertCell(1);
      const cell3 = newRow.insertCell(2);
      const cell4 = newRow.insertCell(3);
      const cell5 = newRow.insertCell(4);

      cell1.textContent = mssv;
      cell2.textContent = hoten;
      cell3.textContent = email;
      cell4.textContent = gender;
      cell5.textContent = noisinh;

      // Xóa form sau khi thêm
      document.getElementById("studentForm").reset();
    }
  </script>
</body>
</html>
